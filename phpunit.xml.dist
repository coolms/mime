<?xml version="1.0" encoding="UTF-8"?>
<!--
    Standalone suite for coolms/mime.

    TWO testsuites, and the split is the point. `mime` is the package's own
    behaviour and must pass with nothing installed but PHPUnit. `oracle` runs the
    same corpus through zbateson/mail-mime-parser and reports where the two
    disagree; it is a DEV dependency of this package alone, never of a consumer,
    and its cases skip themselves when the class is absent so a `composer install`
    without dev dependencies is green rather than red.

    Note: no double hyphen anywhere in this comment. XML forbids it, and PHPUnit
    reports it as "Double hyphen within comment" with no file name attached.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         resolveDependencies="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <testsuites>
        <testsuite name="mime">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="oracle">
            <directory>tests/Oracle</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
